{
  "collapse-filter": true,
  "search": "-path:/^(templates|docs)\\// -path:/^(README|AGENTS|CLAUDE)/ -path:/\\.base$/",
  "showTags": false,
  "showAttachments": false,
  "hideUnresolved": true,
  "showOrphans": true,
  "collapse-color-groups": false,
  "colorGroups": [
    {
      "query": "[type:course]",
      "color": {
        "a": 1,
        "rgb": 15906352
      }
    },
    {
      "query": "[type:topic]",
      "color": {
        "a": 1,
        "rgb": 9926138
      }
    },
    {
      "query": "[type:source-note] OR [type:lecture-note] OR path:/\\/sources\\//",
      "color": {
        "a": 1,
        "rgb": 2275535
      }
    },
    {
      "query": "[type:progress-log]",
      "color": {
        "a": 1,
        "rgb": 15754645
      }
    },
    {
      "query": "[type:assignment] OR path:/\\/exam\\//",
      "color": {
        "a": 1,
        "rgb": 16612884
      }
    },
    {
      "query": "[type:repo] OR path:/^repos\\//",
      "color": {
        "a": 1,
        "rgb": 5017078
      }
    },
    {
      "query": "path:/^areas\\//",
      "color": {
        "a": 1,
        "rgb": 5361510
      }
    },
    {
      "query": "path:/^daily\\//",
      "color": {
        "a": 1,
        "rgb": 8818326
      }
    }
  ],
  "collapse-display": true,
  "showArrow": false,
  "textFadeMultiplier": 0,
  "nodeSizeMultiplier": 1.15,
  "lineSizeMultiplier": 0.7,
  "collapse-forces": true,
  "centerStrength": 0.45,
  "repelStrength": 13,
  "linkStrength": 0.9,
  "linkDistance": 160,
  "scale": 1,
  "close": true
}